{
  "name": "nextjs-with-cache-tags",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "dotenv -c -- playwright test --config playwright.live.config.ts",
    "generate-schema": "node scripts/generate-schema.mjs",
    "format": "biome check . --write --unsafe --diagnostic-level=error && biome format --diagnostic-level=error --write .",
    "prepare": "npm run generate-schema"
  },
  "dependencies": {
    "@datocms/cda-client": "^0.3.2",
    "@datocms/cma-client": "^6.3.0",
    "@libsql/client": "^0.18.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@picocss/pico": "^2.1.1",
    "gql.tada": "^1.11.3",
    "graphql": "^16.14.2",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-datocms": "^8.1.2",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
